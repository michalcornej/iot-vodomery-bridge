# Zkopírujte do .env a vyplňte. Soubor .env nikdy necommitujte.

# Klíč, který klienti (vodoměry, import) posílají v hlavičce X-API-Key.
# Vygenerujte např.: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me

# PostgreSQL (v Docker Compose je DB_HOST přepsán na "db")
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vodomery
DB_USER=vodomery
DB_PASSWORD=change-me

# Odoo (v Docker Compose je ODOO_URL přepsán na http://odoo:8069)
ODOO_URL=http://localhost:8069
ODOO_DB=odoo_vodomery
ODOO_USER=bridge@example.com
# Doporučeno: API klíč uživatele (Preferences → Account Security → New API Key)
ODOO_PASSWORD=change-me

# Heslo databázového uživatele pro Odoo (jen pro Docker Compose)
ODOO_DB_PASSWORD=change-me

# Volitelné
# ODOO_TIMEOUT=15
# MAX_FLOW_RATE_M3_PER_HOUR=10
# MAX_UPLOAD_BYTES=5242880
# DB_POOL_MIN=1
# DB_POOL_MAX=10
